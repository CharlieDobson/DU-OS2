/*===========================================================================
 * EXPLORER.RC  -  Explorer (OS/2 PM) resource script
 * Compile with:  wrc -bt=os2 -r ...
 *
 * OS/2 resource grammar: POPUP is SUBMENU and needs an id (WM_INITMENU names
 * the submenu rather than passing a position), a dialog is
 * a DLGTEMPLATE wrapping a DIALOG, EDITTEXT is ENTRYFIELD, LISTBOX takes
 * LS_* styles, and "&" mnemonics are "~".  Dialog coordinates are dialog
 * units measured from the BOTTOM-left.  There is no VERSIONINFO equivalent.
 *
 * ID_EXPLORER is the frame's window id: FCF_MENU, FCF_ICON and
 * FCF_ACCELTABLE all look their resources up by it, so the MENU, the ICON
 * and the ACCELTABLE below every one carry that number.
 *===========================================================================*/
#include <os2.h>
#include "resource.h"

/*---------------------------------------------------------------------------
 * Icon.  Must be an OS/2-format icon, not a Windows .ICO -- BUILD\MKOS2.CMD
 * converts ..\RES\EXPLORER.ICO into EXPLORER.PTR next to itself before this
 * script is compiled.
 *-------------------------------------------------------------------------*/

ICON ID_EXPLORER "EXPLORER.PTR"

/*---------------------------------------------------------------------------
 * Bitmaps.
 *
 * These are the Windows .BMP files, byte for byte.  A Windows 3.x DIB with a
 * 40-byte BITMAPINFOHEADER is also a valid OS/2 2.0 bitmap: the two file
 * headers have the same 14-byte layout, and OS/2's BITMAPINFOHEADER2 has the
 * same eleven leading fields, so cbFix = 40 is simply a legal truncation of
 * it.  RGBQUAD and RGB2 agree on byte order too.
 *-------------------------------------------------------------------------*/

BITMAP IDB_TB_BACK      "TOOLBAR\\BACK.BMP"
BITMAP IDB_TB_CUT       "TOOLBAR\\CUT.BMP"
BITMAP IDB_TB_COPY      "TOOLBAR\\COPY.BMP"
BITMAP IDB_TB_PASTE     "TOOLBAR\\PASTE.BMP"
BITMAP IDB_TB_RENAME    "TOOLBAR\\RENAME.BMP"
BITMAP IDB_TB_DELETE    "TOOLBAR\\DELETE.BMP"
BITMAP IDB_TB_PROPS     "TOOLBAR\\PROPERTY.BMP"
BITMAP IDB_TB_FIND      "TOOLBAR\\FIND.BMP"

BITMAP IDB_SM_FILE      "SM\\FILE.BMP"
BITMAP IDB_SM_FOLDER    "SM\\FOLDER.BMP"
BITMAP IDB_SM_DRVLOCAL  "SM\\DRVLOCAL.BMP"
BITMAP IDB_SM_DRVNET    "SM\\DRVNET.BMP"
BITMAP IDB_SM_DRVFLOP   "SM\\DRVFLOP.BMP"
BITMAP IDB_SM_DRVCDROM  "SM\\DRVCDROM.BMP"

BITMAP IDB_MD_FILE      "MED\\FILE.BMP"
BITMAP IDB_MD_FOLDER    "MED\\FOLDER.BMP"
BITMAP IDB_MD_DRVLOCAL  "MED\\DRVLOCAL.BMP"
BITMAP IDB_MD_DRVNET    "MED\\DRVNET.BMP"
BITMAP IDB_MD_DRVFLOP   "MED\\DRVFLOP.BMP"
BITMAP IDB_MD_DRVCDROM  "MED\\DRVCDROM.BMP"

BITMAP IDB_LG_FILE      "LRG\\FILE.BMP"
BITMAP IDB_LG_FOLDER    "LRG\\FOLDER.BMP"
BITMAP IDB_LG_DRVLOCAL  "LRG\\DRVLOCAL.BMP"
BITMAP IDB_LG_DRVNET    "LRG\\DRVNET.BMP"
BITMAP IDB_LG_DRVFLOP   "LRG\\DRVFLOP.BMP"
BITMAP IDB_LG_DRVCDROM  "LRG\\DRVCDROM.BMP"

/*---------------------------------------------------------------------------
 * Menu bar
 *-------------------------------------------------------------------------*/

MENU ID_EXPLORER
BEGIN
    SUBMENU "~File", IDM_MENU_FILE
    BEGIN
        SUBMENU "~New", IDM_MENU_NEW
        BEGIN
            MENUITEM "~Window",                 IDM_FILE_NEW_WINDOW
            MENUITEM "~Directory",              IDM_FILE_NEW_DIR
        END
        MENUITEM "~Rename",                     IDM_FILE_RENAME
        MENUITEM "~Delete\tDel",                IDM_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "~Properties",                 IDM_FILE_PROPS
        MENUITEM "Re~fresh\tF5",                IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "~Search...",                  IDM_FILE_SEARCH
        MENUITEM SEPARATOR
        MENUITEM "E~xit\tF3",                   IDM_FILE_EXIT
    END

    SUBMENU "~Edit", IDM_MENU_EDIT
    BEGIN
        MENUITEM "Cu~t\tCtrl+X",                IDM_EDIT_CUT
        MENUITEM "~Copy\tCtrl+C",               IDM_EDIT_COPY
        MENUITEM "~Paste\tCtrl+V",              IDM_EDIT_PASTE
    END

    SUBMENU "~View", IDM_MENU_VIEW
    BEGIN
        MENUITEM "~Small icons",                IDM_VIEW_SMALL
        MENUITEM "~Medium icons",               IDM_VIEW_MEDIUM
        MENUITEM "~Large icons",                IDM_VIEW_LARGE
        MENUITEM "~Details",                    IDM_VIEW_DETAILS
        MENUITEM SEPARATOR
        MENUITEM "Show ~hidden files",          IDM_VIEW_SHOW_HIDDEN
    END

    SUBMENU "~Network", IDM_MENU_NETWORK
    BEGIN
        MENUITEM "~Connect network drive...",   IDM_NETWORK_CONNECT
        MENUITEM "~Disconnect network drive...",IDM_NETWORK_DISCONNECT
    END

    SUBMENU "~Help", IDM_MENU_HELP
    BEGIN
        MENUITEM "~About Explorer...",          IDM_HELP_ABOUT
    END
END

/*---------------------------------------------------------------------------
 * Accelerators (FCF_ACCELTABLE).
 *
 * PM has no virtual key codes for letters, so the Ctrl combinations must be
 * CHAR entries -- and a CHAR entry is matched against the character the key
 * event carries, which for Ctrl+X is 0x18, not 'X'.  They are therefore
 * written as the control codes outright.
 *
 * Do NOT write them as "^X": wrc accepts that spelling but compiles it the
 * Windows way, emitting AF_CHAR | AF_CONTROL with the key left as 'X'
 * (0x58), which no PM key event will ever match.  The accelerator is then
 * simply dead and nothing anywhere reports a problem.
 *
 * F3 is the OS/2 convention for File / Exit.  Delete and the arrow keys are
 * handled in the window procedure instead, because they act on whichever
 * item the grid has focus on rather than being commands in their own right.
 *-------------------------------------------------------------------------*/

ACCELTABLE ID_EXPLORER
BEGIN
    24,     IDM_EDIT_CUT,       CHAR, CONTROL       /* Ctrl+X */
    3,      IDM_EDIT_COPY,      CHAR, CONTROL       /* Ctrl+C */
    22,     IDM_EDIT_PASTE,     CHAR, CONTROL       /* Ctrl+V */
    VK_F5,  IDM_FILE_REFRESH,   VIRTUALKEY
    VK_F3,  IDM_FILE_EXIT,      VIRTUALKEY
END

/*---------------------------------------------------------------------------
 * Context menus.
 *
 * Templates: PMMAIN deletes whichever of "Open" / "Disconnect" does not apply
 * before popping the menu up, which keeps the wording here with the rest of
 * the wording rather than in the middle of a mouse handler.
 *-------------------------------------------------------------------------*/

MENU IDM_CTXMENU_DRIVE
BEGIN
    SUBMENU "", IDM_CTXMENU_DRIVE
    BEGIN
        MENUITEM "~Open",                       IDM_CTX_OPEN
        MENUITEM "~Disconnect",                 IDM_CTX_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "~Properties",                 IDM_CTX_PROPS
    END
END

MENU IDM_CTXMENU_FILE
BEGIN
    SUBMENU "", IDM_CTXMENU_FILE
    BEGIN
        MENUITEM "~Open",                       IDM_CTX_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Cu~t",                        IDM_EDIT_CUT
        MENUITEM "~Copy",                       IDM_EDIT_COPY
        MENUITEM "~Paste",                      IDM_EDIT_PASTE
        MENUITEM "~Rename",                     IDM_FILE_RENAME
        MENUITEM "~Delete",                     IDM_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "P~roperties",                 IDM_CTX_PROPS
    END
END

/*---------------------------------------------------------------------------
 * New directory
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_NEWDIR LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "New Directory", IDD_NEWDIR, 24, 24, 208, 62,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT         "Directory ~name:", IDC_STATIC,        8, 40,  66, 10
        ENTRYFIELD    "",              IDC_NEWDIR_EDIT,     78, 38, 122, 12,
                                       ES_MARGIN | ES_AUTOSCROLL
        DEFPUSHBUTTON "OK",            DID_OK,              84,  8,  40, 14
        PUSHBUTTON    "Cancel",        DID_CANCEL,         130,  8,  40, 14
    END
END

/*---------------------------------------------------------------------------
 * Rename
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_RENAME LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Rename", IDD_RENAME, 24, 24, 208, 76,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT         "",              IDC_RENAME_LABEL,     8, 54, 192, 10
        LTEXT         "New ~name:",    IDC_STATIC,           8, 36,  50, 10
        ENTRYFIELD    "",              IDC_RENAME_EDIT,     62, 34, 138, 12,
                                       ES_MARGIN | ES_AUTOSCROLL
        DEFPUSHBUTTON "OK",            DID_OK,              84,  8,  40, 14
        PUSHBUTTON    "Cancel",        DID_CANCEL,         130,  8,  40, 14
    END
END

/*---------------------------------------------------------------------------
 * About box.  OS/2's ICON keyword is the top-level icon declaration, so the
 * Windows version's icon control is dropped rather than fought with.
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_ABOUT LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "About Explorer", IDD_ABOUT, 24, 24, 216, 76,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT   "Explorer - Dobson Utilities",
                                        IDC_STATIC,  12, 58, 190,  8
        LTEXT   "File manager for OS/2.",
                                        IDC_STATIC,  12, 46, 190,  8
        LTEXT   "Copyright (C) Charlie Dobson 1992 - 2026",
                                        IDC_STATIC,  12, 34, 190,  8
        LTEXT   "All Rights Reserved.",
                                        IDC_STATIC,  12, 22, 190,  8
        DEFPUSHBUTTON "OK",             DID_OK,     166,  4,  40, 14
    END
END

/*---------------------------------------------------------------------------
 * File properties.
 *
 * The Windows dialog's Version Information group read a VERSIONINFO resource
 * through VER.DLL.  OS/2 executables have neither, so its place is taken by
 * the file's extended-attribute size.
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_FILEPROPERTIES LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Properties", IDD_FILEPROPERTIES, 20, 20, 272, 168,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT   "File name:",   IDC_STATIC,         5, 150,  56, 10
        LTEXT   "",             IDC_FILENAME,      66, 150, 140, 10
        LTEXT   "Path:",        IDC_STATIC,         5, 136,  56, 10
        LTEXT   "",             IDC_PATHNAME,      66, 136, 195, 10
        LTEXT   "Last change:", IDC_STATIC,         5, 122,  56, 10
        LTEXT   "",             IDC_LASTCHANGE,    66, 122, 140, 10
        LTEXT   "Size:",        IDC_STATIC,         5, 108,  56, 10
        LTEXT   "",             IDC_FILESIZE,      66, 108, 140, 10
        LTEXT   "EA size:",     IDC_STATIC,         5,  94,  56, 10
        LTEXT   "",             IDC_EASIZE,        66,  94, 140, 10

        GROUPBOX "Attributes",  IDC_STATIC,         5,  28, 180, 58
        AUTOCHECKBOX "~Read only", IDC_READONLY,   14,  60,  74, 12
        AUTOCHECKBOX "~Archive",   IDC_ARCHIVE,    14,  40,  74, 12
        AUTOCHECKBOX "~Hidden",    IDC_HIDDEN,     98,  60,  74, 12
        AUTOCHECKBOX "~System",    IDC_SYSTEM,     98,  40,  74, 12

        DEFPUSHBUTTON "OK",     DID_OK,           206, 148,  50, 14
        PUSHBUTTON    "Cancel", DID_CANCEL,       206, 130,  50, 14
    END
END

/*---------------------------------------------------------------------------
 * Directory properties.  The attribute boxes are display only.
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_DIRPROPERTIES LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Properties", IDD_DIRPROPERTIES, 20, 20, 292, 122,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT   "Directory name:", IDC_STATIC,                  5, 104,  62, 10
        LTEXT   "",       IDC_DIRECTORYNAME,                   72, 104, 156, 10
        LTEXT   "Path:",  IDC_STATIC,                           5,  90,  62, 10
        LTEXT   "",       IDC_DIRECTORYPATH,                   72,  90, 156, 10
        LTEXT   "Last change:", IDC_STATIC,                     5,  76,  62, 10
        LTEXT   "",       IDC_DIRECTORYLASTCHANGE,             72,  76, 156, 10

        GROUPBOX "Attributes", IDC_STATIC,                      5,  10, 150, 58
        AUTOCHECKBOX "Read only", IDC_DIRREADONLY,             12,  42,  64, 12,
                                  WS_DISABLED
        AUTOCHECKBOX "Archive",   IDC_DIRARCHIVE,              12,  22,  64, 12,
                                  WS_DISABLED
        AUTOCHECKBOX "Hidden",    IDC_DIRHIDDEN,               84,  42,  64, 12,
                                  WS_DISABLED
        AUTOCHECKBOX "System",    IDC_DIRSYSTEM,               84,  22,  64, 12,
                                  WS_DISABLED

        DEFPUSHBUTTON "OK",     DID_OK,                       236, 102,  50, 14
        PUSHBUTTON    "Cancel", DID_CANCEL,                   236,  84,  50, 14
    END
END

/*---------------------------------------------------------------------------
 * Drive properties.
 *
 * The Windows dialog carried a volume serial number from INT 21h AX=6900h,
 * in two controls that were already NOT WS_VISIBLE.  OS/2's FSINFO has no
 * serial number; the attached file system takes the slot instead.
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_DRIVEPROPERTIES LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Drive Properties", IDD_DRIVEPROPERTIES, 20, 20, 262, 172,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT   "Drive:",       IDC_STATIC,                 8, 152,  46, 10
        LTEXT   "",             IDC_DRIVEPROPS_LETTER,     58, 152, 100, 10
        LTEXT   "Label:",       IDC_STATIC,                 8, 138,  46, 10
        LTEXT   "",             IDC_DRIVEPROPS_LABEL,      58, 138, 140, 10
        LTEXT   "File system:", IDC_STATIC,                 8, 124,  46, 10
        LTEXT   "",             IDC_DRIVEPROPS_FSTYPE,     58, 124, 140, 10

        GROUPBOX "Disk geometry", IDC_STATIC,               5,  56, 194, 60
        LTEXT   "Bytes per sector:",    IDC_STATIC,        12,  96,  72, 10
        LTEXT   "",             IDC_DRIVEPROPS_BPS,        90,  96, 102, 10
        LTEXT   "Sectors per cluster:", IDC_STATIC,        12,  82,  72, 10
        LTEXT   "",             IDC_DRIVEPROPS_SPC,        90,  82, 102, 10
        LTEXT   "Total clusters:",      IDC_STATIC,        12,  68,  72, 10
        LTEXT   "",             IDC_DRIVEPROPS_CLUSTERS,   90,  68, 102, 10

        GROUPBOX "Space", IDC_STATIC,                       5,   8, 194, 44
        LTEXT   "Total space:", IDC_STATIC,                12,  32,  56, 10
        LTEXT   "",             IDC_DRIVEPROPS_TOTAL,      72,  32, 120, 10
        LTEXT   "Free space:",  IDC_STATIC,                12,  16,  56, 10
        LTEXT   "",             IDC_DRIVEPROPS_FREE,       72,  16, 120, 10

        DEFPUSHBUTTON "OK",     DID_OK,                   206, 152,  50, 14
        PUSHBUTTON    "Cancel", DID_CANCEL,               206, 134,  50, 14
    END
END

/*---------------------------------------------------------------------------
 * Copy / move progress.  Modeless: PMMAIN pumps the queue while it is up.
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_COPYMOVE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Copying", IDD_COPYMOVE, 30, 30, 262, 80,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT   "",     IDC_COPYDLG_OPER,       8, 62, 246, 10
        LTEXT   "File:", IDC_STATIC,            8, 48,  24, 10
        LTEXT   "",     IDC_COPYDLG_FROM,      36, 48, 218, 10
        LTEXT   "To:",  IDC_STATIC,             8, 34,  24, 10
        LTEXT   "",     IDC_COPYDLG_TO,        36, 34, 218, 10
        LTEXT   "",     IDC_COPYDLG_COUNT,      8, 18, 160, 10
        PUSHBUTTON "Cancel", DID_CANCEL,      204,  6,  50, 14
    END
END

/*---------------------------------------------------------------------------
 * Overwrite prompt.
 *
 * Four buttons, so "All" needs an id of its own; PM returns whatever
 * WinDismissDlg was given, which is exactly what the caller wants to see.
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_OVERWRITE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Confirm Overwrite", IDD_OVERWRITE, 30, 30, 232, 74,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT      "",       IDC_OW_MSG,      8, 30, 216, 34
        PUSHBUTTON "~Yes",   IDC_OW_YES,      8,  8,  44, 14
        PUSHBUTTON "~No",    IDC_OW_NO,      60,  8,  44, 14
        PUSHBUTTON "~All",   IDC_OW_ALL,    112,  8,  44, 14
        DEFPUSHBUTTON "Cancel", DID_CANCEL, 172,  8,  50, 14
    END
END

/*---------------------------------------------------------------------------
 * Connect network drive
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_CONNECTNETDRIVE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Connect Network Drive", IDD_CONNECTNETDRIVE, 16, 16, 272, 268,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT    "~Drive:", IDC_STATIC,                  5, 250,  26, 10
        COMBOBOX "",     IDC_NET_LOCALDRIVE,            32, 180, 174, 80,
                         CBS_DROPDOWNLIST | WS_GROUP | WS_TABSTOP
        LTEXT    "~Path:",  IDC_STATIC,                  5, 232,  26, 10
        COMBOBOX "",     IDC_NET_PATH,                  32, 162, 174, 80,
                         CBS_DROPDOWN | WS_GROUP | WS_TABSTOP

        AUTOCHECKBOX "~Reconnect at startup",
                         IDC_RECONNECTATSTART,         126, 212,  86, 12

        DEFPUSHBUTTON "OK",     DID_OK,                216, 248,  50, 14
        PUSHBUTTON    "Cancel", DID_CANCEL,            216, 230,  50, 14

        LTEXT    "~Network:", IDC_STATIC,                5, 200,  80, 10
        LISTBOX  IDC_NET_BROWSE,                         5, 108, 262,  88,
                 LS_HORZSCROLL | WS_GROUP | WS_TABSTOP

        LTEXT    "Shares:", IDC_NET_SHARES_LABEL,        5,  96, 160, 10
        LISTBOX  IDC_NET_SHARES,                         5,   6, 262,  86,
                 LS_HORZSCROLL | WS_GROUP | WS_TABSTOP
    END
END

/*---------------------------------------------------------------------------
 * Disconnect network drive
 *-------------------------------------------------------------------------*/

DLGTEMPLATE IDD_DISCONNECTNETDRIVE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Disconnect Network Drive", IDD_DISCONNECTNETDRIVE,
           24, 24, 188, 96,
           FS_NOBYTEALIGN | FS_DLGBORDER | WS_SAVEBITS,
           FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LISTBOX  IDC_NET_DISCONNLIST,                    5,   6, 116,  84,
                 LS_MULTIPLESEL | LS_HORZSCROLL | WS_GROUP | WS_TABSTOP
        DEFPUSHBUTTON "OK",     DID_OK,                130,  74,  50, 14
        PUSHBUTTON    "Cancel", DID_CANCEL,            130,  56,  50, 14
    END
END
